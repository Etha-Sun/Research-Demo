# SOURCE: research/project-plan-20261102/final-minmax-reproduction/diagnostic-neon-model.patch
# Diagnostic patch to the SALTyRN bounded (cvc5) checker NEON model, neon/ops/core.hpp. The ORIGINAL model built FLOATINGPOINT_MAX
# without NaN propagation and returned VERIFIED on vmax (length 1, VLEN512); with this patch the same harness returns COUNTEREXAMPLE.
# Run in an isolated copy; not a fix of the checker. VERBATIM.
--- original/neon/ops/core.hpp
+++ diagnostic/neon/ops/core.hpp
@@ -1215,6 +1215,12 @@
         Term res_fp = (op == Kind::FLOATINGPOINT_MAX || op == Kind::FLOATINGPOINT_MIN)
                        ? tm.mkTerm(op, {a_fp, b_fp})
                        : tm.mkTerm(op, {rm, a_fp, b_fp});
+        if (op == Kind::FLOATINGPOINT_MAX || op == Kind::FLOATINGPOINT_MIN) {
+            Term either_nan = tm.mkTerm(Kind::OR, {
+                tm.mkTerm(Kind::FLOATINGPOINT_IS_NAN, {a_fp}),
+                tm.mkTerm(Kind::FLOATINGPOINT_IS_NAN, {b_fp})});
+            res_fp = tm.mkTerm(Kind::ITE, {either_nan, tm.mkFloatingPointNaN(8, 24), res_fp});
+        }
         lanes[i] = store_fp32_as_bv(tm, res_fp);
     }
     return NeonVector<32, N>(tm, lanes);
